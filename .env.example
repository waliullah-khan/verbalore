# Supabase (trynearby-ops project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=
DEMO_USER_EMAIL=demo@verbalore.local
DEMO_USER_PASSWORD=

# LLM (OpenRouter) for the writer model
OPENROUTER_API_KEY=
WRITER_MODEL=anthropic/claude-haiku-5.5
FAST_MODEL=anthropic/claude-haiku-5.5

# Jev decision model, called directly on TypeSafe
TYPESAFE_API_KEY=
TYPESAFE_API_BASE=https://api.typesafe.ai
JEV_MODEL=jev-latest

# Research
FIRECRAWL_API_KEY=
APIFY_TOKEN=

# Voice
CARTESIA_API_KEY=

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Posting
UPLOAD_POST_API_KEY=

# CRM (optional, the demo uses fixtures/crm.json)
HUBSPOT_TOKEN=

# Optional: the address the phone QR code points at (an https tunnel or the deployed URL)
PUBLIC_BASE_URL=

# Signals. SEC asks every client to identify itself; use your own name and email.
SEC_USER_AGENT=
GITHUB_TOKEN=
# Optional, lifts the rate limit on the Austin open data portal
SOCRATA_APP_TOKEN=

# Public demo safeguards. The demo workspace never sends real email or posts unless these are true.
ALLOW_DEMO_EMAIL=
ALLOW_DEMO_PUBLISH=
# Comma separated. These people can review access requests at /admin/access
ADMIN_EMAILS=
# Hourly caps on costly work, for a demo anyone can open. Leave empty locally.
JOB_LIMIT_PER_HOUR=
# How many videos one ordinary account can make. Admins and the demo are not limited.
VIDEO_LIMIT=5
# The most accounts that can ever sign up
SIGNUP_LIMIT=50
# One daily ceiling on costly background jobs across every non-admin account (0 turns it off)
GLOBAL_DAILY_JOBS=200
DEMO_HOURLY_CAP=

# Speaker cutout. With a token the worker cuts the speaker out of each new recording in the cloud (about a cent per few clips)
# so the edit can put graphics behind them. Without it the edit uses the stage + deck layout. Admin workspaces are not limited.
REPLICATE_API_TOKEN=
MATTE_DAILY_LIMIT=

# Worker
POLL_INTERVAL_MS=2000
RENDER_FPS=24

# Render
RENDER_CRF=24
